# ─────────────────────────────────────────────
# 必須設定
# ─────────────────────────────────────────────

# Anthropic API キー（https://console.anthropic.com）
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxx

# LINE Developers → チャンネル基本設定 → チャンネルシークレット
LINE_CHANNEL_SECRET=xxxxxxxxxx

# LINE Developers → Messaging API設定 → チャンネルアクセストークン
LINE_CHANNEL_ACCESS_TOKEN=xxxxxxxxxx

# ─────────────────────────────────────────────
# 管理者通知設定
# ─────────────────────────────────────────────

# 管理者自身のLINEユーザーID（APIエラー時に通知が届く）
# 確認方法: LINE Developers → Messaging API設定 → あなたのユーザーID
ADMIN_LINE_USER_ID=Uxxxxxxxxxx

# ─────────────────────────────────────────────
# 動作パラメータ（省略可 / デフォルト値あり）
# ─────────────────────────────────────────────

# 1ユーザーあたり1日のメッセージ上限（デフォルト: 20）
RATE_LIMIT_PER_DAY=20

# 会話履歴の最大保持メッセージ数（デフォルト: 10）
MAX_HISTORY_MESSAGES=10
